{
  "manifest_version": 3,
  "name": "Crimson Desert Companion",
  "version": "1.1.4",
  "description": "Shows your real-time Crimson Desert position on MapGenie and Greymane Codex",
  "browser_specific_settings": {
    "gecko": {
      "id": "cd-map-companion-2026@leandro",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "*://mapgenie.io/*",
    "*://*.mapgenie.io/*",
    "*://crimsondesert.co/*",
    "*://*.crimsondesert.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://crimsondesert.co/map*",
        "*://crimsondesert.co/*/map*",
        "*://*.crimsondesert.co/map*",
        "*://*.crimsondesert.co/*/map*"
      ],
      "js": ["greymane_adapter.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://mapgenie.io/*",
        "*://*.mapgenie.io/*",
        "*://crimsondesert.co/map*",
        "*://crimsondesert.co/*/map*",
        "*://*.crimsondesert.co/map*",
        "*://*.crimsondesert.co/*/map*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://mapgenie.io/*",
        "*://*.mapgenie.io/*",
        "*://crimsondesert.co/map*",
        "*://crimsondesert.co/*/map*",
        "*://*.crimsondesert.co/map*",
        "*://*.crimsondesert.co/*/map*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crimson Desert Companion"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
